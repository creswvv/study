@model GroupForm
@{ ViewData["Title"] = "Новая группа"; }
<div class="container narrow">
    <div class="page-head"><h1>Новая группа</h1></div>
    <div class="card">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="flash err"></div>
            <label>Название</label><input asp-for="Name" /><span asp-validation-for="Name" class="field-err"></span>
            <label>Курс (1-4)</label><input asp-for="Course" type="number" /><span asp-validation-for="Course" class="field-err"></span>
            <div class="form-actions">
                <button class="btn" type="submit">Создать</button>
                <a class="btn btn-light" asp-action="Index">Отмена</a>
            </div>
        </form>
    </div>
</div>
