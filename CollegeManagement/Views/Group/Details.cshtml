@model Group
@{
    ViewData["Title"] = "Группа " + Model.Name;
    var free = (List<Student>)ViewBag.Free;
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Teacher");
}
<div class="container">
    <div class="page-head">
        <div><h1>Группа @Model.Name</h1><p class="muted">@Model.Course курс · студентов: @Model.Students.Count</p></div>
        <div class="row-gap">
            <a class="btn btn-light" asp-action="Index">← Все группы</a>
            @if (User.IsInRole("Admin"))
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Удалить группу?')">
                    <button class="btn btn-danger" type="submit">Удалить группу</button>
                </form>
            }
        </div>
    </div>

    @if (canEdit && free.Count > 0)
    {
        <div class="card">
            <form asp-action="AddStudent" asp-route-id="@Model.Id" method="post" class="inline-form">
                <select name="studentId">
                    @foreach (var s in free) { <option value="@s.Id">@s.FullName</option> }
                </select>
                <button class="btn" type="submit">Добавить в группу</button>
            </form>
        </div>
    }

    <div class="card flush">
        <table class="table">
            <thead><tr><th>ID</th><th>Студент</th><th>Возраст</th><th>Средний балл</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Students.OrderBy(x => x.Surname))
            {
                <tr>
                    <td class="idc">@s.StudentId</td>
                    <td><span class="avatar sm av-@(s.Id % 6)">@s.Initials</span> <a asp-controller="Student" asp-action="Details" asp-route-id="@s.Id">@s.FullName</a></td>
                    <td>@s.Age</td>
                    <td>@(s.Grades.Count == 0 ? "—" : s.Average.ToString("0.00"))</td>
                    <td class="actions">
                        @if (canEdit)
                        {
                            <form asp-action="RemoveStudent" asp-route-id="@Model.Id" asp-route-studentId="@s.Id" method="post">
                                <button class="link danger" type="submit">Исключить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
