@model List<Student>
@{ ViewData["Title"] = "Студенты"; var canEdit = User.IsInRole("Admin") || User.IsInRole("Teacher"); }
<div class="container">
    <div class="page-head">
        <div><h1>Список студентов</h1><p class="muted">Всего: @Model.Count</p></div>
        @if (canEdit) { <a class="btn" asp-action="Create">+ Добавить студента</a> }
    </div>

    <form class="filters" method="get">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Имя, фамилия или ID" />
        <select name="groupId" asp-items="(SelectList)ViewBag.Groups"><option value="">Все группы</option></select>
        <button class="btn btn-light" type="submit">Найти</button>
    </form>

    <div class="card flush">
        <table class="table">
            <thead><tr><th>ID</th><th>Студент</th><th>Возраст</th><th>Группа</th><th>Средний балл</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="idc">@s.StudentId</td>
                    <td><span class="avatar sm av-@(s.Id % 6)">@s.Initials</span> <a href="@Url.Action("Details", new { id = s.Id })">@s.FullName</a></td>
                    <td>@s.Age</td>
                    <td>@(s.Group?.Name ?? "—")</td>
                    <td>@(s.Grades.Count == 0 ? "—" : s.Average.ToString("0.00"))</td>
                    <td class="actions">
                        <a class="link" asp-action="Details" asp-route-id="@s.Id">Профиль</a>
                        @if (canEdit) { <a class="link" asp-action="Edit" asp-route-id="@s.Id">Изменить</a> }
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Удалить студента?')">
                                <button class="link danger" type="submit">Удалить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="muted center">Ничего не найдено</td></tr> }
            </tbody>
        </table>
    </div>
</div>
