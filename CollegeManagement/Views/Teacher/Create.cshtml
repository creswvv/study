@model TeacherForm
@{ ViewData["Title"] = "Новый преподаватель"; }
<div class="container narrow">
    <div class="page-head"><h1>Новый преподаватель</h1></div>
    <div class="card">
        <form method="post" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="flash err"></div>
            <label>Имя</label><input asp-for="Name" /><span asp-validation-for="Name" class="field-err"></span>
            <label>Фамилия</label><input asp-for="Surname" /><span asp-validation-for="Surname" class="field-err"></span>
            <label>Возраст</label><input asp-for="Age" type="number" /><span asp-validation-for="Age" class="field-err"></span>
            <label>Предмет</label><input asp-for="Specialization" /><span asp-validation-for="Specialization" class="field-err"></span>
            <label>Стаж (лет)</label><input asp-for="Experience" type="number" /><span asp-validation-for="Experience" class="field-err"></span>
            <div class="form-actions">
                <button class="btn" type="submit">Сохранить</button>
                <a class="btn btn-light" asp-action="Index">Отмена</a>
            </div>
        </form>
    </div>
</div>
